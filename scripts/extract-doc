#!/usr/bin/env bash
# Convert documents to markdown sidecars. Works from any caller cwd.
# Usage: extract-doc [--force] <absolute-path> [<absolute-path> ...]
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$ROOT/.venv"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "bootstrapping venv..." >&2
  python3 -m venv "$VENV" >&2
  "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt" >&2
fi

exec "$VENV/bin/python" "$ROOT/src/extract_doc.py" "$@"
